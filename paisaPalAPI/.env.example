# Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:8080

# MongoDB Atlas (production) or local (development)
# Atlas example:
MONGODB_URI=mongodb://localhost:27017/paisatracker

# Controls which env file is loaded from ./configs/envs/.env.${APP_ENV}.config
APP_ENV=development

# --- iPhone SMS ingest (POST /api/ingest/sms) ---
# Long-lived per-device secret for the iPhone Shortcut (min 16 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMS_INGEST_SECRET=
# Which user ingested SMS belongs to — set ONE of these:
# SMS_INGEST_USER_ID=<your MongoDB User _id>
# SMS_INGEST_USER_EMAIL=you@example.com
